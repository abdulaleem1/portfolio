---
import '../styles/global.css';
import { experience, projects, skills } from '../data/resume';

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Abdul Aleem Syed is a senior software engineer building scalable SaaS products, cloud systems, and high-quality user experiences."
    />
    <meta name="theme-color" content="#242524" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Abdul Aleem Syed — Senior Software Engineer</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="monogram" href="#top" aria-label="Abdul Aleem Syed, home">AAS<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
        </nav>
        <a class="resume-link" href="/Abdul-Aleem-Resume-2026.pdf" download>Resume <span>↓</span></a>
      </header>

      <main id="top">
        <section class="hero" aria-labelledby="intro-title">
          <div class="eyebrow"><span>PROFILE / 2026</span><i></i><span>01</span></div>
          <div class="hero-grid">
            <div class="hero-copy">
              <p class="availability"><span></span> Based in Milton, Ontario</p>
              <h1 id="intro-title">Abdul Aleem<br /><em class="outline-type surname">Syed</em></h1>
              <p class="role">Senior Software Engineer</p>
            </div>
            <div class="hero-statement">
              <p>
                I turn ambitious ideas into <strong>production-ready SaaS products</strong>—from the
                first interface to the systems that make it scale.
              </p>
              <div class="hero-meta">
                <span>10+ years</span>
                <span>Full stack with focus on UI/UX</span>
                <span>Cloud systems</span>
              </div>
            </div>
          </div>
        </section>

        <section class="split-section" aria-label="Experience summary and top skills">
          <article class="technical-panel experience-preview">
            <div class="panel-title"><span>Selected experience</span><i></i><span>02</span></div>
            <div class="mini-timeline">
              {experience.slice(0, 3).map((item, index) => (
                <div class="mini-role">
                  <span class="mini-index">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <p>{item.company}</p>
                    <h2>{item.role}</h2>
                    <span>{item.period}</span>
                  </div>
                </div>
              ))}
            </div>
            <a class="text-link" href="#experience">Full timeline <span>↘</span></a>
          </article>

          <article class="technical-panel skills-panel">
            <div class="panel-title"><span>Top skills</span><i></i><span>03</span></div>
            <div class="skill-grid">
              {skills.map((skill) => (
                <div class="skill-item">
                  <span
                    class="skill-icon"
                    style={`--skill-icon: url("${skill.icon}")`}
                    aria-hidden="true"
                  ></span>
                  <div>
                    <strong>{skill.name}</strong>
                    <small>{skill.group}</small>
                  </div>
                </div>
              ))}
            </div>
          </article>
        </section>

        <section class="projects-section" id="work" aria-labelledby="projects-title">
          <div class="section-heading">
            <p>Case index / 03</p>
            <h2 id="projects-title">Selected systems</h2>
            <span>Products built for scale, clarity, and measurable impact.</span>
          </div>
          <div class="project-list">
            {projects.map((project) => (
              <article class="project-row">
                <div class="project-number">{project.number}<span>.</span></div>
                <div class="project-main">
                  <p class="project-client">{project.client}</p>
                  <h3>{project.name}</h3>
                  <p class="project-role">{project.role}</p>
                </div>
                <div class="project-detail">
                  <p>{project.description}</p>
                  <span>{project.stack}</span>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="timeline-section" id="experience" aria-labelledby="timeline-title">
          <div class="section-heading section-heading--compact">
            <p>Career log / 04</p>
            <h2 id="timeline-title">Experience</h2>
          </div>
          <div class="timeline">
            {experience.map((item, index) => (
              <article class="timeline-item">
                <div class="timeline-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
                <div class="timeline-meta">
                  <p>{item.period}</p>
                  <span>{item.location}</span>
                </div>
                <div class="timeline-content">
                  <p>{item.company}</p>
                  <h3>{item.role}</h3>
                  <p class="timeline-summary">{item.summary}</p>
                  <ul>
                    {item.highlights.map((highlight) => <li>{highlight}</li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="contact-section" id="contact" aria-labelledby="contact-title">
          <div class="contact-label">Open to the next meaningful challenge</div>
          <h2 id="contact-title">Let’s build something<br /><em class="outline-type">that lasts.</em></h2>
          <div class="contact-grid">
            <a href="mailto:abdulaleem.sd@gmail.com">
              <span>Email</span>
              <strong>abdulaleem.sd@gmail.com</strong>
            </a>
            <a href="https://www.linkedin.com/in/syedabdulaleem/" target="_blank" rel="noreferrer">
              <span>LinkedIn</span>
              <strong>/in/syedabdulaleem ↗</strong>
            </a>
            <a href="tel:+13659943676">
              <span>Phone</span>
              <strong>+1 365 994 3676</strong>
            </a>
          </div>
        </section>
      </main>

      <footer>
        <span>© {currentYear} Abdul Aleem Syed</span>
        <span>Designed with systems in mind</span>
      </footer>
    </div>
  </body>
</html>
